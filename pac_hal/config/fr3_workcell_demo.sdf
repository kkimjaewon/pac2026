<sdf version="1.9">
  <world name="franka_world">


    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>


    <model name="table">
      <static>true</static>
      <pose>0.6 0 0.68 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.8 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.8 0.04</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      <sensor name="table_contacts" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/validation/table_contacts</topic></contact></sensor></link>
    </model>


    <model name="steel_plate">
      <pose>0.35 0 0.705 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>4.2e-5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.3 0.2 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.2 0.01</size></box></geometry>
          <!-- Steel appearance matches A color detector; geometry and collision are unchanged. -->
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      <sensor name="steel_plate_contacts" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>collision</collision><topic>/validation/steel_plate_contacts</topic></contact></sensor></link>
    <static>true</static></model>


    <model name="rgbd_camera">
      <static>true</static>
      <pose>0.35 -0.6 1.5 0 0.9212469046592403 1.5707963267948966</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry><box><size>0.03 0.1 0.03</size></box></geometry>
        </visual>
        <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
          <gz_frame_id>camera_link</gz_frame_id>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>5.0</far></clip>
          </camera>
        </sensor>
      <collision name="camera_collision"><geometry><box><size>0.03 0.1 0.03</size></box></geometry></collision></link>
    </model>

  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" /><model name="table_leg_0_0"><static>true</static><pose>0.19 -0.36 0.33 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></visual></link></model><model name="table_leg_0_1"><static>true</static><pose>0.19 0.36 0.33 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></visual></link></model><model name="table_leg_1_0"><static>true</static><pose>1.01 -0.36 0.33 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></visual></link></model><model name="table_leg_1_1"><static>true</static><pose>1.01 0.36 0.33 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.06 0.06 0.66</size></box></geometry></visual></link></model></world>
</sdf>
