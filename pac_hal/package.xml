<?xml version="1.0"?>
<package format="3">
  <name>pac_hal</name><version>0.1.0</version>
  <description>PAC2026 HAL configuration server and command contract validator</description>
  <maintainer email="kkimjaewon@users.noreply.github.com">Jaewon Kim</maintainer>
  <license>TODO</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend><depend>controller_interface</depend>
  <depend>hardware_interface</depend><depend>pluginlib</depend>
  <depend>realtime_tools</depend><depend>intelion_interfaces</depend>
  <depend>sensor_msgs</depend><depend>std_msgs</depend><depend>geometry_msgs</depend>
  <depend>kdl_parser</depend><depend>urdf</depend><depend>orocos_kdl_vendor</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>libfcl-dev</depend><depend>libassimp-dev</depend><depend>ament_index_cpp</depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>python3-pykdl</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>xacro</exec_depend><exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>pac_worlds</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>franka_gazebo_bringup</exec_depend>
  <exec_depend>franka_description</exec_depend>
