<?xml version="1.0"?>
<sdf version="1.9">
  <world name="franka_world">

    <!-- 기본 시스템들 (센서 시스템 포함) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 조명 -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 바닥 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 작업대 -->
    <model name="table">
      <static>true</static>
      <pose>0.65 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.8 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.8 0.7</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="steel_plate">
      <pose>0.5 0 0.705 0 0 0</pose>
      <link name="link">
        <inertial><mass>2.0</mass><inertia><ixx>0.0067</ixx><iyy>0.015</iyy><izz>0.0217</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.3 0.2 0.01</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.3 0.2 0.01</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 작업대 위 RGB-D 카메라 (아래를 내려다봄) -->
    <model name="rgbd_camera">
      <static>true</static>
      <pose>0.5 0 1.5 0 1.5708 0</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry><box><size>0.03 0.1 0.03</size></box></geometry>
        </visual>
        <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>depth_camera</topic>
          <gz_frame_id>depth_camera_link</gz_frame_id>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
